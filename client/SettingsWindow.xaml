<Window x:Class="Sleepy.SettingsWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.png">
  <StackPanel Margin="22">
    <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold"/>

    <TextBlock Text="Transfers at the same time" Margin="0,16,0,6"/>
    <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="C1" Style="{StaticResource Chip}" GroupName="c" Content="1" Tag="1"/>
      <RadioButton x:Name="C2" Style="{StaticResource Chip}" GroupName="c" Content="2" Tag="2"/>
      <RadioButton x:Name="C3" Style="{StaticResource Chip}" GroupName="c" Content="3" Tag="3"/>
      <RadioButton x:Name="C4" Style="{StaticResource Chip}" GroupName="c" Content="4" Tag="4"/>
    </StackPanel>
    <TextBlock Text="1 is recommended: games install in order and the console uses its full network speed for one download."
               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>

    <TextBlock Text="This PC's address, as seen by the console" Margin="0,18,0,6"/>
    <TextBox x:Name="PcBox"/>
    <TextBlock Text="Leave empty for automatic. Only set this if the console cannot reach your PC (for example with several network adapters or a VPN)."
               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>

    <TextBlock Text="Logs" Margin="0,18,0,6"/>
    <StackPanel Orientation="Horizontal">
      <Button Content="Open logs folder" Style="{StaticResource GhostButton}" Click="OpenLogs_Click"/>
      <Button Content="Copy console log" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ConsoleLog_Click"/>
    </StackPanel>
    <TextBlock Text="client.log records everything this app does. The console log shows what the installer on the PS4 was doing, even if it crashed."
               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>

    <TextBlock x:Name="Message" Foreground="{StaticResource Err}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="22,7" Click="Save_Click" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
