<Window x:Class="Sleepy.ConnectWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to your PS4" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.png">
  <StackPanel Margin="22">
    <!-- not connected -->
    <StackPanel x:Name="DisconnectedPanel">
      <TextBlock Text="Connect to your PS4" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Open Sleepy Package Installer on the console, then enter the IP address shown on its screen." TextWrapping="Wrap"
                 Foreground="{StaticResource Dim}" Margin="0,6,0,14"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBox x:Name="HostBox" FontSize="14" KeyDown="Host_KeyDown"/>
        <TextBox x:Name="PortBox" Grid.Column="1" Margin="8,0,0,0" FontSize="14" KeyDown="Host_KeyDown"/>
      </Grid>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
        <Button x:Name="FindBtn" Grid.Column="1" Content="Find my console" Margin="8,0,0,0" Click="Find_Click"/>
      </Grid>
      <ItemsControl x:Name="FoundList" Margin="0,10,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Label}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Click="Found_Click" Tag="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- connected -->
    <StackPanel x:Name="ConnectedPanel" Visibility="Collapsed">
      <TextBlock Text="Connected" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ok}"/>
      <TextBlock x:Name="ConnectedText" Margin="0,8,0,0" FontSize="14"/>
      <TextBlock x:Name="ConnectedDetail" Margin="0,4,0,0" Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button Content="Check installed games" Click="Refresh_Click"/>
        <Button Content="Disconnect" Margin="8,0,0,0" Click="Disconnect_Click"/>
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="Message" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Dim}"/>
    <Button Content="Close" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click" IsCancel="True"/>
  </StackPanel>
</Window>
