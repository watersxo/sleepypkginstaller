<Window x:Class="Sleepy.FoldersWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Package folders" Width="560" Height="440" MinHeight="320" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.png">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Package folders" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Every folder is searched, including sub-folders. You can also drag folders onto the main window." TextWrapping="Wrap"
                 Foreground="{StaticResource Dim}" Margin="0,6,0,12"/>
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}">
      <Grid>
        <ListBox x:Name="FolderList" Style="{StaticResource PlainList}" Padding="6">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                <Button Grid.Column="1" Content="Remove" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" Tag="{Binding}" Click="Remove_Click"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Text="No folders yet." Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal">
        <Button Content="Add folder…" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
        <Button Content="Rescan all" Margin="8,0,0,0" Click="Rescan_Click"/>
      </StackPanel>
      <Button Content="Done" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Done_Click" IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
