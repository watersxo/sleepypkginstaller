<Window x:Class="Sleepy.MainWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sleepy"
        Title="Sleepy Package Installer" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" Icon="Assets/app.png">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <DataTemplate x:Key="BadgeTemplate" DataType="{x:Type local:BadgeVM}">
      <Border x:Name="Bd" CornerRadius="10" Padding="8,2" Margin="0,7,5,0" Background="{StaticResource Panel2}">
        <TextBlock x:Name="Tx" Text="{Binding Text}" FontSize="11" Foreground="{StaticResource Dim}"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="ok">
          <Setter TargetName="Bd" Property="Background" Value="#14301F"/><Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Ok}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="update">
          <Setter TargetName="Bd" Property="Background" Value="#2A2A14"/><Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Warn}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="dlc">
          <Setter TargetName="Bd" Property="Background" Value="#1A2740"/><Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Accent}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="err">
          <Setter TargetName="Bd" Property="Background" Value="#3A1B1B"/><Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Err}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="GameTemplate" DataType="{x:Type local:GameVM}">
      <Border x:Name="Card" Margin="0,0,0,8" Padding="12" CornerRadius="10" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="1" MouseLeftButtonUp="Card_MouseUp" Cursor="Hand">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border Grid.Column="1" Width="72" Height="72" CornerRadius="8" Background="{StaticResource Panel2}">
              <Border.Child>
                <Border CornerRadius="8">
                  <Border.Background><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Border.Background>
                </Border>
              </Border.Child>
            </Border>
            <StackPanel Grid.Column="2" Margin="14,0,10,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
              <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource BadgeTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="{Binding PlanText}" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding ExpandText}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Click="Expand_Click"/>
                <Button Content="Send" IsEnabled="{Binding CanSend}" Padding="16,5" FontSize="12" Margin="4,0,0,0" Click="SendOne_Click"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Parts}" Margin="0,10,0,0"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:PartVM}">
                <Grid Margin="0,3">
                  <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" Content="{Binding Label}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" FontSize="12"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
          <Setter TargetName="Card" Property="Background" Value="{StaticResource SelectedBg}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="JobTemplate" DataType="{x:Type local:JobVM}">
      <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding KindText}" FontSize="10" Foreground="{StaticResource Dim}"/>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="Pause" Tag="pause" Click="Job_Click" Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}"/>
              <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Resume" Tag="resume" Click="Job_Click" Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}"/>
              <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Retry" Tag="retry" Click="Job_Click" Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}"/>
              <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Cancel" Tag="cancel" Click="Job_Click" Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}"/>
              <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove from list" Tag="remove" Click="Job_Click" Visibility="{Binding CanRemove, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Grid>
          <ProgressBar Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Bar}" Margin="0,8,0,0"/>
          <Grid Margin="0,6,0,0">
            <TextBlock Text="{Binding Status}" FontSize="12"/>
            <TextBlock Text="{Binding Right}" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
          </Grid>
          <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolVis}}" Margin="0,5,0,0">
            <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Foreground="{StaticResource Err}" Background="Transparent"
                     BorderThickness="0" Padding="0" FontSize="12"/>
            <Button Content="Copy error details" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" HorizontalAlignment="Left" Margin="-8,4,0,0" Click="CopyError_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- header -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5B8DEF" Offset="0"/><GradientStop Color="#8A6BF0" Offset="1"/></LinearGradientBrush></Border.Background>
            <TextBlock Text="Zz" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock VerticalAlignment="Center" FontSize="15"><Run Text="Sleepy" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><Run Text=" Package Installer"/></TextBlock>
        </StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center" MaxWidth="520">
          <TextBox x:Name="SearchBox" TextChanged="Search_Changed"/>
          <TextBlock Text="Search games or title IDs…" Foreground="{StaticResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Connect_Click" Padding="14,7">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="9" Height="9" Fill="{Binding ConDot}" Margin="0,0,9,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ConText}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>

      <!-- library -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Margin="18,12,18,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Chip}" GroupName="f" Content="All" Tag="all" IsChecked="True" Checked="Filter_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="f" Content="Not installed" Tag="new" Checked="Filter_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="f" Content="Has update" Tag="update" Checked="Filter_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="f" Content="Has DLC" Tag="dlc" Checked="Filter_Checked"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="Sort" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="s" Content="Name" Tag="name" IsChecked="True" Checked="Sort_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="s" Content="Size" Tag="size" Checked="Sort_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="s" Content="Recent" Tag="recent" Checked="Sort_Checked"/>
          </StackPanel>
          <Button Grid.Column="3" Style="{StaticResource GhostButton}" Click="Folders_Click" Padding="12,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,1,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Folders" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="18,0,18,8" Visibility="{Binding ScanVisibility}">
          <ProgressBar Height="22" Value="{Binding ScanPercent, Mode=OneWay}"/>
          <TextBlock Text="{Binding ScanText}" FontSize="12" Foreground="{StaticResource Dim}" Margin="10,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
          <ListBox x:Name="GameList" Style="{StaticResource PlainList}" ItemsSource="{Binding GamesView}" ItemTemplate="{StaticResource GameTemplate}" Padding="18,4,6,12"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyVisibility}">
            <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Dim}" TextAlignment="Center" FontSize="14" LineHeight="24"/>
            <Button Content="Add a folder" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" HorizontalAlignment="Center" Click="Folders_Click" Visibility="{Binding AddFolderVisibility}"/>
          </StackPanel>
        </Grid>

        <Border Grid.Row="3" Visibility="{Binding SelVisibility}" Margin="18,0,18,16" Padding="14,10" CornerRadius="12" Background="#1B2636" BorderBrush="#34506F" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelText}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Select all shown" Style="{StaticResource GhostButton}" Click="SelectAll_Click"/>
              <Button Content="Clear" Style="{StaticResource GhostButton}" Click="SelectNone_Click"/>
              <Button Content="Send to console" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Padding="18,7" IsEnabled="{Binding CanSendSelected}" Click="SendSelected_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- transfers -->
      <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="16,14,16,6">
            <TextBlock Text="Transfers" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SpeedText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </Grid>
          <StackPanel Grid.Row="1" Margin="16,0,16,8" Visibility="{Binding OverallVisibility}">
            <ProgressBar Value="{Binding OverallPercent, Mode=OneWay}" Margin="0,2,0,5"/>
            <TextBlock Text="{Binding OverallText}" FontSize="12" Foreground="{StaticResource Dim}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,8">
            <Button Content="Pause all" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="12" Click="PauseAll_Click"/>
            <Button Content="Resume all" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="12" Click="ResumeAll_Click"/>
            <Button Content="Clear finished" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="12" Click="ClearDone_Click"/>
          </StackPanel>
          <Grid Grid.Row="3">
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding JobsView}" ItemTemplate="{StaticResource JobTemplate}" Padding="12,0,4,10"/>
            <TextBlock Text="Nothing queued.&#x0A;Tick some games and press Send to console." TextAlignment="Center" Foreground="{StaticResource Dim}" LineHeight="24"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding QueueEmptyVisibility}"/>
          </Grid>
          <Grid Grid.Row="4" Margin="16,10">
            <TextBlock Text="{Binding PcInfo}" FontSize="12" Foreground="{StaticResource Dim}"/>
            <Button Content="Settings" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" HorizontalAlignment="Right" Click="Settings_Click"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- toast -->
    <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,200,24" Padding="16,9" CornerRadius="10"
            Background="{Binding ToastBg}" BorderBrush="#34506F" BorderThickness="1" Visibility="{Binding ToastVisibility}" IsHitTestVisible="False">
      <TextBlock Text="{Binding ToastText}"/>
    </Border>
  </Grid>
</Window>
